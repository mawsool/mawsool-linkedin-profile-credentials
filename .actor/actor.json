{
  "$schema": "https://apify.com/schemas/v1/actor.ide.json",
  "actorSpecification": 1,
  "name": "mawsool-linkedin-profile-credentials",
  "title": "LinkedIn Certifications and Patents",
  "description": "Get LinkedIn certifications, patents, courses, publications, and organizations from profile URLs. From $1 per 1,000 profiles.",
  "seoTitle": "LinkedIn Certifications and Patents",
  "seoDescription": "Scrape LinkedIn certifications, patents, courses, and publications from profile URLs. $1 per 1,000.",
  "categories": [
    "LEAD_GENERATION",
    "SOCIAL_MEDIA"
  ],
  "version": "1.0",
  "buildTag": "latest",
  "minMemoryMbytes": 256,
  "maxMemoryMbytes": 1024,
  "defaultRunOptions": {
    "build": "latest",
    "timeoutSecs": 21600,
    "memoryMbytes": 256
  },
  "environmentVariables": {
    "ACTOR_SLICE": "credentials",
    "CHARGE_EVENT": "profile-credentials",
    "GUEST_API_KEY": "@mawsoolGuestApiKey"
  },
  "meta": {
    "templateId": "ts-empty",
    "generatedBy": "Cursor Agent"
  },
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "storages": {
    "dataset": "./dataset_schema.json"
  },
  "pricing": "./pay_per_event.json",
  "dockerfile": "../Dockerfile"
}
